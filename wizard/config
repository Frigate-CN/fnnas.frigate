[
  {
    "stepTitle": "${config.introStepTitle}",
    "items": [
      {
        "type": "tips",
        "helpText": "${config.introHelpText}"
      },
      {
        "type": "select",
        "field": "wizard_network_suffix",
        "label": "${config.networkModeLabel}",
        "initValue": "-bridge",
        "options": [
          {
            "label": "${config.networkBridgeLabel}",
            "value": "-bridge"
          },
          {
            "label": "${config.networkHostLabel}",
            "value": "-host"
          }
        ],
        "rules": [
          {
            "required": false,
            "message": "${config.networkModeRequiredMessage}"
          }
        ]
      },
      {
        "type": "tips",
        "helpText": "${config.networkHelpText}"
      },
      {
        "type": "select",
        "field": "wizard_auth",
        "label": "${config.authLabel}",
        "initValue": "gateway",
        "options": [
          {
            "label": "${config.authGatewayLabel}",
            "value": "gateway"
          },
          {
            "label": "${config.authNativeLabel}",
            "value": "native"
          }
        ],
        "rules": [
          {
            "required": false,
            "message": "${config.authRequiredMessage}"
          }
        ]
      },
      {
        "type": "tips",
        "helpText": "${config.authHelpText}"
      },
      {
        "type": "text",
        "field": "wizard_shm_size",
        "label": "${config.shmSizeLabel}",
        "initValue": "",
        "rules": [
          {
            "pattern": "^([0-9]+(\\.[0-9]+)?([kKmMgG][bB]?)?)?$",
            "message": "${config.shmSizePatternMessage}"
          }
        ]
      },
      {
        "type": "tips",
        "helpText": "${config.shmSizeHelpText}"
      }
    ]
  }
]
